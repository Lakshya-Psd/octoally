# Keep the repository LF-only (as upstream) even when Windows editors write CRLF.
* text=auto eol=lf

# Windows script files need CRLF to run reliably.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf
*.vbs text eol=crlf

# Binary assets
*.png binary
*.ico binary
*.icns binary
*.node binary
*.exe binary
